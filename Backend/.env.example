DATABASE_URL=sqlite:///./fx_dashboard.db
GROQ_API_KEY=your_key_here

# Auth — set a long random string in production (32+ bytes).
# The app logs a warning at startup while the insecure default is in use.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Email (Gmail app password — https://support.google.com/accounts/answer/185833)
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=youraddress@gmail.com

# Daily news digest schedule
DIGEST_HOUR=8
DIGEST_TIMEZONE=Africa/Tunis
